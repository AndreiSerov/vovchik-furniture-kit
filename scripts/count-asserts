#!/usr/bin/env python3
"""Count assertion lines in tests, at a git ref and in the working tree (ticket 73.2).

  scripts/count-asserts <git-ref>

Prints one line per `tests/*.py` file: name, count at the ref, count in the working tree, and `<` when the
working-tree count is lower. A line counts if it contains `assert` or `pytest.raises`. The exit code is 1 when
any count dropped, so a conversion that loses a check is visible. A file absent on one side counts 0.
"""

import re
import subprocess
import sys
from pathlib import Path

PATTERN = re.compile(r"assert|pytest\.raises")


def count(text: str) -> int:
    return sum(1 for line in text.splitlines() if PATTERN.search(line))


def git(*args: str, cwd: Path | None = None) -> str:
    return subprocess.run(["git", *args], capture_output=True, text=True, check=True, cwd=cwd).stdout


def at_ref(root: Path, ref: str) -> dict[str, int]:
    # `--full-tree` и `cwd=root`: результат не зависит от папки, из которой запущен скрипт
    names = git("ls-tree", "--full-tree", "--name-only", ref, "tests/", cwd=root).split()
    return {Path(n).name: count(git("show", f"{ref}:{n}", cwd=root)) for n in names if n.endswith(".py")}


def main() -> int:
    if len(sys.argv) != 2:
        print(__doc__, file=sys.stderr)
        return 2
    root = Path(git("rev-parse", "--show-toplevel").strip())
    before = at_ref(root, sys.argv[1])
    after = {p.name: count(p.read_text(encoding="utf-8")) for p in sorted((root / "tests").glob("*.py"))}
    dropped = 0
    for name in sorted(before | after):
        b, a = before.get(name, 0), after.get(name, 0)
        dropped += a < b
        print(f"{name} {b} {a}" + (" <" if a < b else ""))
    print(f"total {sum(before.values())} {sum(after.values())}")
    return 1 if dropped else 0


if __name__ == "__main__":
    sys.exit(main())
