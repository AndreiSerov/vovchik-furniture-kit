#!/usr/bin/env python3
"""Link skills/kitchen-*/ into the folders where Claude Code, Codex and Qwen Code look for skills.

Relative symlinks go into .claude/skills/, .agents/skills/ and .qwen/skills/. --hermes also links
into ~/.hermes/skills/ with absolute targets: that writes to the home folder, so run it by hand.
Only symlinks named kitchen-* that point into skills/ count as ours; nothing else is touched.
"""

import argparse
import os
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
SOURCE = ROOT / "skills"
PLACES = [".claude/skills", ".agents/skills", ".qwen/skills"]
PREFIX = "kitchen-"


def wanted() -> list[str]:
    if not SOURCE.is_dir():
        return []
    return sorted(
        p.name for p in SOURCE.glob(f"{PREFIX}*") if p.is_dir() and (p / "SKILL.md").is_file()
    )


def points_into_source(link: Path) -> bool:
    target = os.path.normpath(os.path.join(os.path.realpath(link.parent), os.readlink(link)))
    return os.path.commonpath([target, str(SOURCE)]) == str(SOURCE) and target != str(SOURCE)


def check_folder(folder: Path, names: list[str]) -> list[str]:
    """Report what sync_folder would have to fix, changing nothing."""
    problems = []
    if folder.is_dir():
        for entry in sorted(folder.glob(f"{PREFIX}*")):
            if entry.is_symlink() and entry.name not in names and points_into_source(entry):
                problems.append(f"{entry} is a dangling link to a removed skill")
    for name in names:
        link = folder / name
        if link.is_symlink():
            if not points_into_source(link):
                problems.append(f"{link} is a foreign symlink, not ours")
            elif not (link / "SKILL.md").is_file():
                problems.append(f"{link} is a dangling link (target has no SKILL.md)")
            elif os.path.realpath(link) != os.path.realpath(SOURCE / name):
                problems.append(f"{link} points at the wrong skill")
        elif link.exists():
            problems.append(f"{link} is a real file or folder, not our link")
        else:
            problems.append(f"{link} is missing")
    return problems


def sync_folder(folder: Path, names: list[str], absolute: bool) -> list[str]:
    """Bring one folder in line with `names`; return the problems found."""
    problems = []
    folder.mkdir(parents=True, exist_ok=True)
    for entry in sorted(folder.glob(f"{PREFIX}*")):
        if entry.is_symlink() and entry.name not in names and points_into_source(entry):
            entry.unlink()
            print(f"removed {entry}")
    for name in names:
        link = folder / name
        target = SOURCE / name
        wish = str(target) if absolute else os.path.relpath(target, folder)
        if link.is_symlink():
            if os.readlink(link) == wish:
                continue
            if not points_into_source(link):
                problems.append(f"{link} is someone else's symlink; left alone")
                continue
            link.unlink()
        elif link.exists():
            problems.append(f"{link} is a real file or folder, not our link; skipped")
            continue
        link.symlink_to(wish)
        print(f"linked {link} -> {wish}")
    return problems


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument("--hermes", action="store_true", help="also link into ~/.hermes/skills")
    parser.add_argument("--check", action="store_true", help="report problems, change nothing")
    args = parser.parse_args()

    names = wanted()
    if args.check:
        found = []
        for place in PLACES:
            found += check_folder(ROOT / place, names)
        if args.hermes:
            found += check_folder(Path.home() / ".hermes" / "skills", names)
        for problem in found:
            print(problem)
        print("kitchen links OK" if not found else f"{len(found)} problem(s); run scripts/link-skills")
        return 1 if found else 0
    problems = []
    for place in PLACES:
        problems += sync_folder(ROOT / place, names, absolute=False)
    if args.hermes:
        problems += sync_folder(Path.home() / ".hermes" / "skills", names, absolute=True)
    for problem in problems:
        print(f"warning: {problem}", file=sys.stderr)
    print(f"{len(names)} kitchen skills linked" if not problems else f"{len(problems)} problem(s)")
    return 1 if problems else 0


if __name__ == "__main__":
    sys.exit(main())
